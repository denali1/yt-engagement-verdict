{
  "manifest_version": 3,
  "name": "YT Engagement Verdict",
  "version": "1.1.5",
  "description": "Scores YouTube videos on engagement quality and renders a verdict: View Botted, Hot Garbage, Solid Video, or Legit on Fire.",
  "author": "Denali",

  "icons": {
    "48": "icons/icon48.png",
    "96": "icons/icon96.png"
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon48.png",
      "96": "icons/icon96.png"
    },
    "default_title": "YT Engagement Verdict"
  },

  "background": {
    "service_worker": "background.js"
  },

  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "scripting"
  ],

  "host_permissions": [
    "*://www.youtube.com/*",
    "*://returnyoutubedislikeapi.com/*",
    "*://raw.githubusercontent.com/*",
    "*://yt-engagement-verdict-api.steve-mcknelly-cloudflare.workers.dev/*"
  ],

  "web_accessible_resources": [
    {
      "resources": ["icons/*", "welcome.html", "welcome.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
