{
  "manifest_version": 2,
  "name": "YT Engagement Verdict",
  "version": "1.1.3",
  "description": "Analyzes YouTube video engagement (views, likes, dislikes, comments) and renders a statistically-grounded authenticity verdict below the view count.",
  "author": "Denali",
  "homepage_url": "https://github.com/Denali1/yt-engagement-verdict",

  "icons": {
    "48": "icons/icon48.png",
    "96": "icons/icon96.png"
  },

  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon48.png",
      "96": "icons/icon96.png"
    },
    "default_title": "YT Engagement Verdict"
  },

  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },

  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "*://www.youtube.com/*",
    "*://returnyoutubedislikeapi.com/*",
    "*://raw.githubusercontent.com/*",
    "*://yt-engagement-verdict-api.steve-mcknelly-cloudflare.workers.dev/*"
  ],

  "web_accessible_resources": [
    "icons/*",
    "welcome.html",
    "welcome.js"
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "yt-engagement-verdict@denali1",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": ["technicalAndInteraction"]
      }
    }
  }
}
