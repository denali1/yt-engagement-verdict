{
  "manifest_version": 2,
  "name": "YT Engagement Verdict",
  "version": "1.0.0",
  "description": "Analyzes YouTube video engagement (views, likes, dislikes, comments) and renders a statistically-grounded authenticity verdict below the view count.",
  "author": "Denali",
  "homepage_url": "https://github.com/Denali1/yt-engagement-verdict",

  "icons": {
    "48": "icons/icon48.png",
    "96": "icons/icon96.png"
  },

  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon48.png",
      "96": "icons/icon96.png"
    },
    "default_title": "YT Engagement Verdict"
  },

  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/watch*"],
      "js": ["verdict.js", "ryd.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],

  "permissions": [
    "activeTab",
    "storage",
    "*://returnyoutubedislikeapi.com/*",
    "*://raw.githubusercontent.com/*"
  ],

  "host_permissions": [
    "*://www.youtube.com/*",
    "*://returnyoutubedislikeapi.com/*",
    "*://raw.githubusercontent.com/*"
  ],

  "web_accessible_resources": [
    "icons/*"
  ]
}
